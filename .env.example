# Copy to .env and adjust. All variables are optional in local dev except where noted.

# Required when DJANGO_DEBUG is off.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True

# Postgres from docker-compose (`db` service); the hostnames below only resolve
# inside the compose network. If unset, falls back to SQLite (db.sqlite3).
DATABASE_URL=postgres://flashform:flashform@db:5432/flashform

# Redis from docker-compose: channels_redis + Redis cache. If unset (e.g. CI), the
# in-memory channel layer + LocMemCache are used (single process only).
REDIS_URL=redis://redis:6379/0

# Celery broker. Defaults to redis://redis:6379/1 when unset.
# CELERY_BROKER_URL=redis://redis:6379/1

# False = no Celery worker or broker needed (e.g. a single Railway service): emails and
# delayed teacher events run in a thread pool inside the web process instead.
# USE_CELERY=True

# Comma-separated lists.
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Number of trusted reverse proxies in front of the app (for rate-limit client IPs).
# 0 locally; 1 on Railway, or every client shares the proxy's IP (and its rate limits).
NUM_PROXIES=0

# Only read when DJANGO_DEBUG is off (production): redirect http to https, and the HSTS
# max-age in seconds. /api/health is never redirected, so the host's health check works.
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=2592000

# Student join rate limits (DRF rate strings). Defaults follow PRD §8. A whole class
# behind one school NAT shares an IP, so the per-IP limit may need raising.
# JOIN_RATE_PER_IP=10/min
# JOIN_RATE_PER_ROOM=60/min

# --- Email (PRD §8, §14) ---
APP_NAME=Flashform
# Links in emails point here (the Next.js app), e.g. {FRONTEND_URL}/verify-email?token=...
FRONTEND_URL=http://localhost:3000
SUPPORT_EMAIL=support@example.com
# Leave empty in local dev: emails are then logged (docker compose logs -f worker)
# instead of sent. Get a key at https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Must be a sender verified in Brevo.
BREVO_FROM_EMAIL=no-reply@example.com

# Optional SMTP transport (EmailService.send_smtp_mail only; Brevo is the default).
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
